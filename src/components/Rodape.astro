---
import { u } from '../lib/url';
import Marca from './Marca.astro';
import Icone from './Icone.astro';
import { empresa, temWhatsapp, linkWhatsapp } from '../config/empresa';

interface Props {
  /** Esconde a faixa de chamada (usado na própria página de orçamento). */
  semChamada?: boolean;
}
const { semChamada = false } = Astro.props;
const c = empresa.contato;
const ano = new Date().getFullYear();
---

<footer class="rodape">
  {
    !semChamada && (
      <section class="chamada" aria-labelledby="chamada-titulo">
        <div class="faixa chamada__corpo">
          <h2 class="t-destaque" id="chamada-titulo">Sua casa tem medidas únicas. Seus móveis também deveriam ter.</h2>
          <p class="t-lead">Conte qual ambiente quer transformar. Em poucos minutos você nos passa o essencial; nós voltamos com os próximos passos.</p>
          <div class="acoes chamada__acoes">
            <a class="botao" href={u('/orcamento')}>
              Pedir meu orçamento <Icone nome="seta" />
            </a>
            {temWhatsapp && (
              <a class="botao botao--whats" href={linkWhatsapp(`Olá! Vim pelo site da ${empresa.nome} e quero um orçamento.`)} target="_blank" rel="noopener">
                <Icone nome="whatsapp" /> Chamar no WhatsApp
              </a>
            )}
          </div>
        </div>
      </section>
    )
  }

  <div class="base">
    <div class="faixa">
      <div class="base__grade">
        <div class="base__marca">
          <a href={u('/')} aria-label={`${empresa.nome} — página inicial`}><Marca /></a>
          <p>Móveis planejados sob medida, da medição à montagem, em {empresa.regiaoAtendimento}.</p>
          <a class="base__cta" href={u('/orcamento')}>Pedir orçamento <Icone nome="seta" /></a>
        </div>

        <nav class="base__coluna" aria-labelledby="rodape-nav">
          <h2 id="rodape-nav">Navegar</h2>
          <ul role="list">
            <li><a href={u('/projetos')}>Ambientes</a></li>
            <li><a href={u('/projetos#em-3d')}>Ambientes em 3D</a></li>
            <li><a href={u('/sobre')}>Como trabalhamos</a></li>
            <li><a href={u('/orcamento')}>Orçamento</a></li>
          </ul>
        </nav>

        <div class="base__coluna">
          <h2>Atendimento</h2>
          <ul role="list">
            <li><span><Icone nome="local" />{empresa.endereco || empresa.regiaoAtendimento}</span></li>
            {c.telefone && (
              <li>
                <a href={`tel:${c.telefone.replace(/\D/g, '')}`}><Icone nome="telefone" />{c.telefone}</a>
              </li>
            )}
            {c.email && (
              <li>
                <a href={`mailto:${c.email}`}><Icone nome="email" />{c.email}</a>
              </li>
            )}
            {temWhatsapp && (
              <li>
                <a href={linkWhatsapp(`Olá! Vim pelo site da ${empresa.nome}.`)} target="_blank" rel="noopener"><Icone nome="whatsapp" />WhatsApp</a>
              </li>
            )}
            {empresa.horario && (
              <li>
                <span><Icone nome="relogio" />{empresa.horario}</span>
              </li>
            )}
            {c.instagram && (
              <li>
                <a href={`https://instagram.com/${c.instagram}`} target="_blank" rel="noopener"><Icone nome="instagram" />@{c.instagram}</a>
              </li>
            )}
            <li><a href={u('/orcamento')}><Icone nome="formulario" />Formulário de orçamento</a></li>
          </ul>
        </div>
      </div>

      <div class="base__legal">
        <p>© {ano} {empresa.nomeCompleto}{empresa.cnpj && ` · CNPJ ${empresa.cnpj}`}</p>
        <p class="base__credito">Fotos de ambientes: referências do Unsplash, com crédito em cada imagem. Cozinha: estudo 3D.</p>
        <a href={u('/privacidade')}>Privacidade</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .chamada {
    background: var(--papel-2);
    padding-block: clamp(56px, 8vw, 112px);
    text-align: center;
  }
  .chamada__corpo {
    display: grid;
    justify-items: center;
    gap: 20px;
  }
  .chamada h2 {
    max-width: 22ch;
  }
  .chamada .t-lead {
    max-width: 52ch;
  }
  .chamada__acoes {
    justify-content: center;
    margin-top: 8px;
  }

  .base {
    background: var(--grafite);
    color: var(--sobre-grafite);
    padding-block: clamp(48px, 6vw, 80px) 24px;
  }
  .base__grade {
    display: grid;
    gap: 40px;
    padding-bottom: clamp(36px, 5vw, 56px);
  }
  .base__marca {
    display: grid;
    gap: 16px;
    align-content: start;
    justify-items: start;
  }
  .base__marca > a:first-child {
    text-decoration: none;
    padding-block: 6px;
  }
  .base__marca p {
    color: var(--sobre-grafite-2);
    max-width: 34ch;
    line-height: 1.55;
  }
  .base__cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 48px;
    margin-top: 6px;
    padding: 0 22px;
    border-radius: 999px;
    background: var(--creme);
    color: var(--grafite);
    font-weight: 650;
    text-decoration: none;
    transition: background-color 0.2s var(--ease), transform 0.1s var(--ease);
  }
  .base__cta:hover {
    background: var(--led);
  }
  .base__cta:active {
    transform: scale(0.97);
  }
  .base__cta :global(svg) {
    width: 18px;
    height: 18px;
  }
  .base__coluna h2 {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--sobre-grafite-2);
    margin-bottom: 10px;
  }
  .base__coluna ul {
    display: grid;
  }
  .base__coluna a,
  .base__coluna span {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    text-decoration: none;
    line-height: 1.35;
  }
  .base__coluna a:hover {
    color: var(--led);
  }
  .base__coluna :global(svg) {
    width: 18px;
    height: 18px;
    flex: none;
    color: var(--sobre-grafite-2);
  }
  .base__legal {
    display: grid;
    gap: 6px;
    padding-top: 20px;
    border-top: 1px solid #43372d;
    font-size: 0.85rem;
    color: var(--sobre-grafite-2);
  }
  .base__legal a {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    width: fit-content;
  }
  .base__legal a:hover {
    color: var(--led);
  }
  @media (min-width: 720px) {
    .base__grade {
      grid-template-columns: 1fr 1fr;
    }
    .base__marca {
      grid-column: 1 / -1;
    }
  }
  @media (min-width: 1024px) {
    .base__grade {
      grid-template-columns: 5fr 3fr 4fr;
      column-gap: clamp(40px, 6vw, 96px);
    }
    .base__marca {
      grid-column: auto;
    }
    .base__legal {
      grid-template-columns: auto 1fr auto;
      align-items: center;
      column-gap: 32px;
    }
    .base__credito {
      text-align: center;
    }
  }
</style>
