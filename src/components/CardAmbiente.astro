---
// Card de ambiente: foto alta de cantos arredondados, nome em Didone e seta.
import { Picture } from 'astro:assets';
import Icone from './Icone.astro';
import { u } from '../lib/url';
import type { Ambiente } from '../content/ambientes';

interface Props {
  ambiente: Ambiente;
  prioridade?: boolean;
  href?: string;
}
const { ambiente: a, prioridade = false, href = `/projetos#${a.id}` } = Astro.props;
---

<a class="card" href={u(href)}>
  <div class="card__foto">
    <Picture
      src={a.imagem}
      alt={a.alt}
      widths={[360, 540, 760]}
      sizes="(min-width: 1280px) 15vw, (min-width: 900px) 30vw, 46vw"
      formats={['avif', 'webp']}
      fallbackFormat="webp"
      loading={prioridade ? 'eager' : 'lazy'}
    />
  </div>
  <span class="card__nome">
    <span>{a.nome}</span>
    <Icone nome="seta" />
  </span>
  <span class="card__chamada">{a.chamada}</span>
</a>

<style>
  .card {
    display: grid;
    gap: 10px;
    text-decoration: none;
    height: 100%;
    align-content: start;
  }
  .card__foto {
    aspect-ratio: 3 / 4;
    border-radius: var(--raio);
    overflow: hidden;
    background: var(--papel-2);
  }
  .card__foto :global(picture),
  .card__foto :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .card__foto :global(img) {
    transition: transform 1.1s var(--ease), filter 1.1s var(--ease);
  }
  .card:hover .card__foto :global(img) {
    transform: scale(1.05);
    filter: saturate(1.08);
  }
  .card__nome {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    font-family: var(--f-serif);
    font-variation-settings: 'opsz' 12;
    font-weight: 500;
    font-size: clamp(0.92rem, 0.85rem + 0.3vw, 1.05rem);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1.25;
    padding-top: 4px;
  }
  .card__nome :global(svg) {
    width: 18px;
    height: 18px;
    flex: none;
    transition: transform 0.4s var(--ease);
  }
  .card:hover .card__nome :global(svg) {
    transform: translateX(4px);
  }
  .card:hover .card__nome {
    color: var(--madeira);
  }
  .card__chamada {
    font-size: 0.9rem;
    line-height: 1.45;
    color: var(--tinta-2);
    text-wrap: pretty;
  }
</style>
