---
// Logotipo provisório: o nome em sans, caixa alta espaçada.
// (A versão em Didone aparece só no herói da página inicial.)
import { empresa } from '../config/empresa';
interface Props {
  tamanho?: 'normal' | 'grande';
}
const { tamanho = 'normal' } = Astro.props;
---

<span class:list={['marca', `marca--${tamanho}`]}>{empresa.nome}</span>

<style>
  .marca {
    font-family: var(--f-sans);
    font-weight: 700;
    font-size: 1.12rem;
    line-height: 1;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    /* compensa o espaçamento após a última letra */
    margin-right: -0.22em;
  }
  .marca--grande {
    font-size: clamp(2.2rem, 1.4rem + 4vw, 4.5rem);
    letter-spacing: 0.1em;
    margin-right: -0.1em;
  }
</style>
