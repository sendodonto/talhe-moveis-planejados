---
import { u } from '../../lib/url';
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Cozinha3D from '../../components/Cozinha3D.astro';
import { materiais } from '../../content/cozinha';
import { empresa } from '../../config/empresa';
import vista from '../../assets/renders/vista-inicial.png';
import dBancada from '../../assets/renders/detalhe-bancada.png';
import dRipado from '../../assets/renders/detalhe-ripado.png';
import dLed from '../../assets/renders/detalhe-led.png';

const orcamento = '/orcamento?ambiente=cozinha&referencia=cozinha-em-u';
const detalhes = [
  { src: dBancada, legenda: 'Granito preto, cooktop e forno alinhados', alt: 'Bancada de granito preto polido com cooktop de embutir e forno de inox abaixo.' },
  { src: dLed, legenda: 'Faixa amadeirada com LED quente', alt: 'Faixa de portas amadeiradas com fita de LED embutida iluminando o revestimento branco.' },
  { src: dRipado, legenda: 'Ripado vertical na península', alt: 'Ripas verticais de madeira na face externa da península, sob o tampo de granito.' },
];
---

<Base
  titulo="Cozinha em U em 3D"
  descricao="Explore em 3D uma cozinha em U com armários grafite até o teto, faixa amadeirada com LED, bancada de granito preto e península ripada."
  imagem={vista}
  imagemAlt="Cozinha em U com armários grafite, faixa de madeira com LED e península ripada."
>
  <header class="faixa cabeca">
    <nav aria-label="Trilha" class="trilha">
      <a href={u('/projetos')}>Ambientes</a> <span aria-hidden="true">/</span> <span aria-current="page">Cozinha em U</span>
    </nav>
    <div class="cabeca__grade">
      <h1 class="t-display">Grafite, madeira e <em>granito preto</em></h1>
      <div class="pilha" style="--espaco: 14px">
        <p class="t-lead">Gire, aproxime e toque nos números. Cada ponto mostra uma decisão de projeto — e por que ela foi tomada.</p>
        <p class="t-nota">
          <span class="selo-imagem">Estudo 3D</span> Modelo reconstruído a partir de uma referência visual, com medidas aproximadas. Mostra soluções e
          acabamentos; não é uma obra executada pela {empresa.nome}.
        </p>
      </div>
    </div>
  </header>

  <section class="faixa explorar" id="explorar" aria-label="Explorar a cozinha">
    <Cozinha3D id="cozinha-pagina" auto ctaHref={orcamento} ctaTexto="Quero uma cozinha assim" />
  </section>

  <section class="faixa secao materiais" id="materiais" aria-labelledby="materiais-titulo">
    <div class="materiais__cabeca">
      <h2 class="t-titulo" id="materiais-titulo">Seis materiais, <em>cada um com função</em></h2>
      <p class="t-texto">No projeto real, cada padrão é escolhido com amostra física na mão.</p>
    </div>
    <ul role="list" class="materiais__lista">
      {
        materiais.map((m) => (
          <li>
            <span class="materiais__amostra" style={`--cor:${m.cor}`} aria-hidden="true" />
            <strong>{m.nome}</strong>
            <span>{m.uso}</span>
          </li>
        ))
      }
    </ul>

    <ul role="list" class="detalhes">
      {
        detalhes.map((d) => (
          <li class="revela">
            <figure>
              <Picture src={d.src} alt={d.alt} widths={[480, 800, 1200]} sizes="(min-width: 900px) 30vw, 100vw" formats={['avif', 'webp']} fallbackFormat="webp" />
              <figcaption>{d.legenda}</figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  .cabeca {
    padding-block: clamp(16px, 3vw, 36px) clamp(20px, 3vw, 32px);
  }
  .trilha {
    display: flex;
    gap: 8px;
    margin-bottom: 14px;
    font-size: 0.85rem;
    color: var(--tinta-2);
  }
  .trilha a {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    margin-block: -14px;
  }
  .cabeca__grade {
    display: grid;
    gap: 20px;
  }
  .cabeca h1 {
    max-width: 18ch;
    font-size: clamp(1.8rem, 1.2rem + 2.2vw, 3rem);
  }
  .cabeca .selo-imagem {
    margin-right: 6px;
  }
  @media (min-width: 1024px) {
    .cabeca__grade {
      grid-template-columns: 7fr 5fr;
      align-items: end;
      column-gap: clamp(40px, 5vw, 96px);
    }
  }
  .explorar {
    scroll-margin-top: calc(var(--topo) + 12px);
  }

  .materiais__cabeca {
    display: grid;
    gap: 12px;
    margin-bottom: 28px;
  }
  .materiais__lista {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .materiais__lista li {
    display: grid;
    gap: 4px;
    padding: 16px;
    border-radius: var(--raio);
    background: var(--creme);
    font-size: 0.9rem;
    line-height: 1.4;
  }
  .materiais__lista strong {
    font-weight: 600;
  }
  .materiais__lista span:last-child {
    color: var(--tinta-2);
  }
  .materiais__amostra {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--cor);
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.12);
    margin-bottom: 8px;
  }
  .detalhes {
    display: grid;
    gap: 20px;
    margin-top: clamp(40px, 6vw, 72px);
  }
  .detalhes figure {
    display: grid;
    gap: 10px;
  }
  .detalhes :global(picture) {
    display: block;
    aspect-ratio: 4 / 5;
    border-radius: var(--raio-g);
    overflow: hidden;
    background: var(--papel-2);
  }
  .detalhes :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .detalhes figcaption {
    font-family: var(--f-serif);
    font-size: 0.95rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  @media (min-width: 900px) {
    .materiais__cabeca {
      grid-template-columns: 1fr 1fr;
      align-items: end;
    }
    .materiais__lista {
      grid-template-columns: repeat(3, 1fr);
    }
    .detalhes {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (min-width: 1280px) {
    .materiais__lista {
      grid-template-columns: repeat(6, 1fr);
    }
  }
</style>
