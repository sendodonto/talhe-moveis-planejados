    display: grid;
    gap: clamp(64px, 9vw, 128px);
  }
  .item {
    display: grid;
    gap: 24px;
    scroll-margin-top: calc(var(--topo) + 24px);
  }
  .item__foto {
    display: grid;
    gap: 8px;
  }
  .item__foto :global(picture) {
    display: block;
    aspect-ratio: 4 / 5;
    border-radius: var(--raio-g);
    overflow: hidden;
  }
  .item__foto :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .item__foto figcaption {
    font-size: 0.78rem;
    color: var(--tinta-2);
  }
  .item__foto figcaption a {
    color: inherit;
    display: inline-block;
    padding-block: 6px;
  }
  .item__texto {
    display: grid;
    gap: 16px;
    align-content: center;
  }
  .item__inclui {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-block: 4px 8px;
  }
  .item__inclui li {
    padding: 8px 14px;
    border-radius: 999px;
    background: var(--papel-2);
    font-size: 0.92rem;
    line-height: 1.3;
  }
  @media (min-width: 900px) {
    .item {
      grid-template-columns: 5fr 6fr;
      gap: clamp(40px, 6vw, 104px);
      align-items: center;
    }
