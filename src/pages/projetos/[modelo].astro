---
import { u } from '../../lib/url';
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Visualizador3D from '../../components/Visualizador3D.astro';
import Icone from '../../components/Icone.astro';
import { modelos, type ModeloSite } from '../../content/modelos';
import { empresa } from '../../config/empresa';

export function getStaticPaths() {
  return modelos.map((modelo) => ({ params: { modelo: modelo.slug }, props: { modelo } }));
}

const { modelo } = Astro.props as { modelo: ModeloSite };
const orcamento = `/orcamento?ambiente=${modelo.ambiente}&referencia=${modelo.slug}`;
const outros = modelos.filter((m) => m.id !== modelo.id);
---

<Base titulo={`${modelo.nome} em 3D`} descricao={modelo.seo} imagem={modelo.poster.paisagem} imagemAlt={modelo.alt}>
  <header class="faixa cabeca">
    <nav aria-label="Trilha" class="trilha">
      <a href={u('/projetos')}>Ambientes</a> <span aria-hidden="true">/</span> <span aria-current="page">{modelo.nome}</span>
    </nav>
    <h1 class="t-destaque">{modelo.titulo}</h1>
    <p class="cabeca__lead">{modelo.lead}</p>
    <p class="cabeca__nota">
      <span class="selo-imagem">Estudo 3D</span>
      <span>{modelo.aviso} pela {empresa.nome}.</span>
    </p>
  </header>

  <section class="faixa explorar" id="explorar" aria-label={`Explorar: ${modelo.nome}`}>
    <Visualizador3D modelo={modelo} id="v3d-pagina" auto />
  </section>

  <section class="faixa secao materiais" id="materiais" aria-labelledby="materiais-titulo">
    <div class="materiais__intro">
      <h2 class="t-destaque" id="materiais-titulo">O que compõe este ambiente.</h2>
      <p class="t-texto">{modelo.materiais.length} materiais, cada um com uma função. No seu projeto, cada padrão é escolhido com amostra física na mão.</p>
      <a class="botao" href={u(orcamento)}>{modelo.cta} <Icone nome="seta" /></a>
    </div>
    <ul role="list" class="materiais__lista">
      {
        modelo.materiais.map((m) => (
          <li>
            <span class="materiais__amostra" style={`--cor:${m.cor}`} aria-hidden="true" />
            <span class="materiais__nome">{m.nome}</span>
            <span class="materiais__uso">{m.uso}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="detalhes" aria-labelledby="detalhes-titulo">
    <div class="faixa detalhes__cabeca">
      <h2 class="detalhes__titulo" id="detalhes-titulo">De perto</h2>
    </div>
    <ul role="list" class="detalhes__faixa">
      {
        modelo.detalhes.map((d) => (
          <li>
            <figure>
              <Picture src={d.src} alt={d.alt} widths={[480, 800, 1200]} sizes="(min-width: 900px) 30vw, 82vw" formats={['avif', 'webp']} fallbackFormat="webp" />
              <figcaption>{d.legenda}</figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="faixa outros" aria-labelledby="outros-titulo">
    <h2 class="outros__titulo" id="outros-titulo">Explore outros ambientes em 3D</h2>
    <ul role="list" class="outros__lista">
      {
        outros.map((m) => (
          <li>
            <a href={u(`/projetos/${m.slug}`)}>
              <Picture src={m.poster.paisagem} alt="" widths={[480, 800]} sizes="(min-width: 900px) 40vw, 90vw" formats={['avif', 'webp']} fallbackFormat="webp" />
              <span class="outros__nome">
                {m.nome} <Icone nome="seta" />
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  .cabeca {
    display: grid;
    gap: 14px;
    padding-block: clamp(16px, 3vw, 36px) clamp(22px, 3vw, 36px);
  }
  .trilha {
    display: flex;
    gap: 8px;
    font-size: 0.85rem;
    color: var(--tinta-2);
  }
  .trilha a {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    margin-block: -12px;
  }
  .cabeca h1 {
    max-width: 22ch;
  }
  .cabeca__lead {
    font-size: clamp(1.05rem, 1rem + 0.3vw, 1.2rem);
    color: var(--tinta-2);
    max-width: 52ch;
  }
  .cabeca__nota {
    display: flex;
    align-items: baseline;
    gap: 10px;
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--tinta-2);
    max-width: 70ch;
  }
  .cabeca__nota .selo-imagem {
    flex: none;
  }
  .explorar {
    scroll-margin-top: calc(var(--topo) + 12px);
  }

  /* ——— Materiais ——— */
  .materiais {
    display: grid;
    gap: 32px;
  }
  .materiais__intro {
    display: grid;
    gap: 16px;
    align-content: start;
    justify-items: start;
  }
  .materiais__intro .botao {
    margin-top: 8px;
  }
  /* no celular a chamada já está logo acima, junto do 3D */
  @media (max-width: 1023px) {
    .materiais__intro .botao {
      display: none;
    }
  }
  .materiais__lista {
    display: grid;
    border-top: 1px solid var(--linha-forte);
  }
  .materiais__lista li {
    display: grid;
    grid-template-columns: 40px 1fr;
    grid-template-areas: 'amostra nome' 'amostra uso';
    column-gap: 16px;
    row-gap: 2px;
    align-items: center;
    padding: 16px 0;
    border-bottom: 1px solid var(--linha);
  }
  .materiais__amostra {
    grid-area: amostra;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--cor);
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.12);
  }
  .materiais__nome {
    grid-area: nome;
    font-weight: 650;
    letter-spacing: -0.01em;
  }
  .materiais__uso {
    grid-area: uso;
    font-size: 0.93rem;
    color: var(--tinta-2);
  }
  @media (min-width: 1024px) {
    .materiais {
      grid-template-columns: 4fr 7fr;
      column-gap: clamp(48px, 7vw, 120px);
    }
    .materiais__intro {
      position: sticky;
      top: calc(var(--topo) + 32px);
    }
    .materiais__lista {
      grid-template-columns: 1fr 1fr;
      column-gap: 40px;
    }
  }

  /* ——— Detalhes: faixa deslizante no celular, três colunas no desktop ——— */
  .detalhes {
    padding-bottom: clamp(56px, 7vw, 96px);
  }

  /* ——— Outros ambientes ——— */
  .outros {
    padding-bottom: clamp(64px, 8vw, 120px);
  }
  .outros__titulo {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--tinta-2);
    margin-bottom: 14px;
  }
  .outros__lista {
    display: grid;
    gap: 14px;
  }
  .outros__lista a {
    display: grid;
    gap: 10px;
    text-decoration: none;
  }
  .outros__lista :global(picture) {
    display: block;
    aspect-ratio: 16 / 9;
    border-radius: var(--raio);
    overflow: hidden;
    background: #eae4dd;
  }
  .outros__lista :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.9s var(--ease);
  }
  .outros__lista a:hover :global(img) {
    transform: scale(1.03);
  }
  .outros__nome {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 650;
    font-size: 1.1rem;
    letter-spacing: -0.015em;
  }
  .outros__nome :global(svg) {
    width: 18px;
    height: 18px;
    transition: transform 0.3s var(--ease);
  }
  .outros__lista a:hover .outros__nome :global(svg) {
    transform: translateX(4px);
  }
  @media (min-width: 900px) {
    .outros__lista {
      grid-template-columns: 1fr 1fr;
      gap: 20px;
    }
  }
  .detalhes__titulo {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--tinta-2);
    margin-bottom: 14px;
  }
  .detalhes__faixa {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 82%;
    gap: 12px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--margem);
    padding-inline: var(--margem);
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }
  .detalhes__faixa::-webkit-scrollbar {
    display: none;
  }
  .detalhes__faixa li {
    scroll-snap-align: start;
  }
  .detalhes__faixa figure {
    display: grid;
    gap: 10px;
  }
  .detalhes__faixa :global(picture) {
    display: block;
    aspect-ratio: 4 / 3;
    border-radius: var(--raio);
    overflow: hidden;
    background: var(--papel-2);
  }
  .detalhes__faixa :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .detalhes__faixa figcaption {
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  @media (min-width: 900px) {
    .detalhes__faixa {
      max-width: var(--largura);
      margin-inline: auto;
      grid-auto-flow: row;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
      overflow: visible;
    }
  }
</style>
